[Unit]
Description=Shoko with required external storage
Requires=docker.service mnt-4TB.mount mediabox-storage-watch-shoko.service
After=docker.service mnt-4TB.mount mediabox-storage-watch-shoko.service
BindsTo=mnt-4TB.mount
OnFailure=mediabox-storage-contain-shoko.service

[Service]
Type=simple
EnvironmentFile=/etc/mediabox-storage/shoko.env
ExecStartPre=/usr/local/lib/mediabox/require-mount.sh /mnt/4TB ${SHOKO_MEDIA_UUID}
ExecStart=/usr/bin/docker compose -f ${SHOKO_COMPOSE_FILE} --profile external-storage up --no-deps shoko
ExecStop=/usr/bin/docker compose -f ${SHOKO_COMPOSE_FILE} --profile external-storage stop --timeout 20 shoko
Restart=no
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
